# Browser-safe Convex deployment URL. Static hosting injects this during deployment.
VITE_CONVEX_URL=

# Public, non-secret forwarding address created in AgentMail. Leave blank until the inbox exists.
VITE_AGENTMAIL_FORWARDING_ADDRESS=

# Set only in the Convex deployment environment, never in Vite/browser env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
FIRECRAWL_API_KEY=
FIRECRAWL_WEBHOOK_SECRET=
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
AGENTMAIL_INBOX_ID=
DEMO_MODE=true
DEMO_VENDOR_EMAIL=
CAPABILITY_HASH_PEPPER=
RAW_RETENTION_DAYS=7
